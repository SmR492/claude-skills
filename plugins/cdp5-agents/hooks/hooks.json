{
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "^cdp5-agents:",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-contract.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^cdp5-agents:",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-ack.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
