{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<PLUGIN>/probes/<SCRIPT>\" <ARG>",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
